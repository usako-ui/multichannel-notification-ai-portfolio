# =========================================
# .env.example
# マルチチャネル通知システム｜環境変数テンプレート
# =========================================
# このファイルは Git 管理する（値は絶対に入れない・キー名のみ）
# 新しくクローンした人は .env.local にコピーして値を埋める
#
# ⚠️ NEXT_PUBLIC_ を付けてよいのは Supabase の URL / ANON_KEY のみ
#    他は全てサーバー専用（付けるとブラウザに配信されて漏洩する）

# ─────────────────────────────
# Supabase
# ─────────────────────────────
# Supabase ダッシュボード > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
# service_role キー（RLS をバイパスできる強力な権限・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# ─────────────────────────────
# LINE（Messaging API）
# ─────────────────────────────
# LINE Developers > チャネル基本設定
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LINE Developers > Messaging API 設定
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# 営業部長の個人 LINE User ID
LINE_MANAGER_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────
# Gmail OAuth
# ─────────────────────────────
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント ID
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# OAuth フロー実行で取得（prompt=consent を付ける）
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────
# Slack
# ─────────────────────────────
# Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# 各チャネル ID（Slack でチャネル名クリック > 一番下に表示）
SLACK_CHANNEL_RENTAL=C0XXXXXXXXX
SLACK_CHANNEL_SALE=C0XXXXXXXXX
SLACK_CHANNEL_VIEWING=C0XXXXXXXXX
SLACK_CHANNEL_COMPLAINT=C0XXXXXXXXX
SLACK_CHANNEL_OTHER=C0XXXXXXXXX

# ─────────────────────────────
# Gemini API
# ─────────────────────────────
# Google AI Studio > Get API key
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# モデル切替用（任意）。未設定時はコード内デフォルト gemini-flash-latest（エイリアス）が使われる。
# バージョン固定（例: gemini-2.5-flash）は EOL で 404 になるリスクがあるため非推奨。
# 特定バージョンで固定運用したい場合のみ設定する。
# GEMINI_MODEL=gemini-flash-latest

# 月間予算（トークン数）。80% 到達時に営業部長 LINE Push でアラート通知される。
# 未設定時のデフォルトは 1,000,000 トークン。実運用時は課金プラン・想定処理量に合わせて明示指定推奨。
# 例：無料枠上限に合わせる場合 or 有料課金の月次予算をトークン数に換算した値
GEMINI_MONTHLY_TOKEN_LIMIT=1000000

# ─────────────────────────────
# Vercel Cron 保護
# ─────────────────────────────
# /api/cron/classify エンドポイントの Bearer 認証用シークレット
# 生成例: openssl rand -hex 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────
# Gmail Pub/Sub Push（クレーム SLA 5 分以内・即時 LINE Push 用）
# ─────────────────────────────
# 目的：GitHub Actions schedule 遅延（数時間ノー発火の実績あり）を回避し、
#       Gmail クレームを LINE Webhook と同レベルの数秒で検知する。
#
# GCP コンソール（Misa 実施済み・参考値）:
#   プロジェクト ID    : multichannel-notify
#   Pub/Sub トピック   : gmail-push-topic
#   サブスクリプション : gmail-push-sub（Push 型）
#   Push エンドポイント: https://multichannel-notification-ai-dev.vercel.app/api/webhooks/gmail-push?token=$GMAIL_PUSH_SECRET
GOOGLE_CLOUD_PROJECT_ID=multichannel-notify
PUBSUB_TOPIC_NAME=gmail-push-topic

# /api/webhooks/gmail-push の共有シークレット（サブスクリプションの endpoint URL に ?token= で付与する）
# 生成例: openssl rand -hex 32
GMAIL_PUSH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
